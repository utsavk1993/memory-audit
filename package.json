{
  "name": "memory-audit",
  "version": "1.0.0",
  "description": "Inspect, verify and fix your Claude Code memory notes against your own session logs. Runs locally.",
  "license": "MIT",
  "author": "Utsav Kumar",
  "homepage": "https://github.com/utsavk1993/memory-audit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utsavk1993/memory-audit.git"
  },
  "bugs": {
    "url": "https://github.com/utsavk1993/memory-audit/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "agent-memory",
    "memory",
    "audit",
    "llm"
  ],
  "bin": {
    "memory-audit": "bin/memory-audit.mjs"
  },
  "files": [
    "bin",
    "plugin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/trace*",
    "public",
    "next.config.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3210",
    "build": "next build && node scripts/build-cli.mjs",
    "start": "node bin/memory-audit.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "prepack": "next build && node scripts/build-cli.mjs && node scripts/scrub-build-paths.mjs",
    "build:plugin": "node scripts/build-cli.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^7",
    "vitest": "^4.1.12"
  }
}
